# Copy to your shell or process manager; never commit real values.
NIGHTFALL_DATABASE_URL=postgresql://nightfall_app:app_dev_only@127.0.0.1:5432/nightfall
NIGHTFALL_MIGRATION_DATABASE_URL=postgresql://nightfall_owner:owner_dev_only@127.0.0.1:5432/nightfall
# 32 random bytes, base64:  python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
NIGHTFALL_SECRET_KEY=
NIGHTFALL_PUBLIC_ORIGIN=http://localhost:3000
# Trusted reverse proxies in front of the API that SET X-Forwarded-For (e.g. Caddy routing
# /api/* straight to the API = 1). Keep 0 behind the Next.js dev proxy: it forwards a
# client-supplied X-Forwarded-For unchanged, so trusting it would let clients spoof their IP.
NIGHTFALL_FORWARDED_HOPS=0

# Worker (run `nightfall-worker`): its own least-privilege role, same evidence directory as the API.
NIGHTFALL_WORKER_DATABASE_URL=postgresql://nightfall_worker:worker_dev_only@127.0.0.1:5432/nightfall
NIGHTFALL_EVIDENCE_DIR=var/evidence
# live (default) = real crt.sh / DNS lookups. fixture = canned test data, tests only.
NIGHTFALL_COLLECTOR_MODE=live
