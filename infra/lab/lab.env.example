# Copy to lab.env (same folder) and fill in. lab.env is git-ignored; never commit it.
#
# DB_HOST: the Neon host name. In Vercel: Project → Settings → Environment Variables →
#          PGHOST_UNPOOLED (looks like ep-xxxx.us-east-1.aws.neon.tech). Not a secret.
# LAB_DB_PASSWORD: a long random value you generate (see README). Put the SAME value in
#          Vercel as NIGHTFALL_LAB_WORKER_DB_PASSWORD, then redeploy.
DB_HOST=
DB_NAME=neondb
LAB_DB_PASSWORD=

# --- Switches (leave empty to keep them off) ---------------------------------------------
# Must match the BLACKSITE console's settings (blacksite.env). The worker re-checks them
# before lab tool pack 1 runs. A reference starting "SELF:" is your own self-review: it only
# counts while SELF_REVIEW_UNTIL (a date at most 90 days ahead) hasn't passed, and JANUS
# always labels it "not independent". Any other reference means an independent review.
BLACKSITE_ENABLED=false
BLACKSITE_REVIEW_REF=
LAB_PACK1_REVIEW_REF=
SELF_REVIEW_UNTIL=
