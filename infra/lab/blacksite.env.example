# BLACKSITE console settings for the lab machine. Copy to blacksite.env (same folder; it's
# git-ignored) and fill in. Start it with start-blacksite.ps1. Never put the owner (migration)
# credentials here.
#
# Database: the confined nightfall_blacksite role. Its password is the value you put in Vercel
# as NIGHTFALL_BLACKSITE_DB_PASSWORD (then redeployed, which turns the login on).
NIGHTFALL_DATABASE_URL=postgresql://nightfall_blacksite:PASSWORD@DB_HOST/neondb?sslmode=require
# Must be the SAME value as Vercel's NIGHTFALL_SECRET_KEY, so your two-factor secret decrypts.
NIGHTFALL_SECRET_KEY=
NIGHTFALL_PUBLIC_ORIGIN=http://127.0.0.1:8443
NIGHTFALL_COOKIE_SECURE=false
NIGHTFALL_BLACKSITE_ENABLED=true
NIGHTFALL_BLACKSITE_PORT=8443
NIGHTFALL_LAB_NETWORKS=172.30.99.0/24
# Reviews (see lab.env.example): keep these the same as in lab.env.
NIGHTFALL_BLACKSITE_REVIEW_REF=
NIGHTFALL_LAB_PACK1_REVIEW_REF=
NIGHTFALL_SELF_REVIEW_UNTIL=
