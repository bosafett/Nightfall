# Copy to profile-b.env (never commit it: it holds the private key). See README.md.

# Vercel -> Environment Variables -> PGHOST_UNPOOLED (looks like ep-....neon.tech)
DB_HOST=
DB_NAME=neondb
# The value you set as NIGHTFALL_WORKER_DB_PASSWORD in Vercel (README step 2).
WORKER_DB_PASSWORD=

# From: nightfall-admin profile-b-keygen (README step 1). The public key also goes in Vercel;
# the private key goes ONLY here.
PROFILE_B_PUBLIC_KEY=
PROFILE_B_PRIVATE_KEY=

# Off until Profile B's review is recorded (docs/reviews/packets/3-profile-b.md). Use the
# same values as in Vercel. A "SELF:" reference only counts until SELF_REVIEW_UNTIL.
PROFILE_B_ENABLED=false
PROFILE_B_REVIEW_REF=
SELF_REVIEW_UNTIL=
