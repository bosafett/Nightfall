# janus-sensor settings. Copy to /etc/janus-sensor/sensor.env (mode 600, owned by root).
JANUS_URL=https://your-janus-deployment.example
# The key JANUS showed once when you registered this sensor (SHIELD -> Intrusion Detection).
JANUS_SENSOR_KEY=nfs_replace_me
# Addresses this machine must never block, whatever JANUS says: your home/office IP, the
# BLACKSITE lab, your VPN. Comma-separated. This list is enforced here, on the machine.
JANUS_SENSOR_ALLOWLIST=
# How to run cscli. On a host install: cscli. With CrowdSec in Docker: docker exec crowdsec cscli
JANUS_SENSOR_CSCLI=cscli
JANUS_SENSOR_STATE=/var/lib/janus-sensor/state.json
